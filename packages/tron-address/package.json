{
  "name": "@tronless/tron-address",
  "version": "0.1.0",
  "description": "TRON address validator and converter: validate TRC-20 / TRX addresses, convert Base58 (T...) to hex (41...) and EVM 0x format, derive an address from a public key. CLI + JavaScript library.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "types": "./index.d.ts",
  "bin": {
    "tron-address": "./bin/tron-address.js"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "keywords": [
    "tron",
    "tron address",
    "tron address validator",
    "validate tron address",
    "tron address to hex",
    "hex to tron address",
    "base58 tron",
    "trc20 address",
    "trc20 address checker",
    "tron address converter",
    "usdt trc20",
    "tronweb",
    "crypto address validation"
  ],
  "dependencies": {
    "@noble/hashes": "^2.0.0"
  },
  "license": "MIT",
  "author": "TronLess <https://tronless.app>",
  "homepage": "https://github.com/TronLess/tron-tools/tree/main/packages/tron-address#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TronLess/tron-tools.git",
    "directory": "packages/tron-address"
  },
  "bugs": {
    "url": "https://github.com/TronLess/tron-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
